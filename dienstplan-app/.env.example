# Deine Adresse, unter der die Seite erreichbar ist (ohne / am Ende)
DOMAIN=dienstplan.example.de
BASE_URL=https://dienstplan.example.de

# Name des ersten Admins (nur beim allerersten Start) – so wie er im Dienstplan steht,
# dann werden die eigenen Dienste automatisch zugeordnet
ADMIN_NAME=Mähler
# Kontaktadresse für Push-Benachrichtigungen (Pflichtangabe der Browser-Hersteller)
ADMIN_EMAIL=du@example.de

# Optional: KI-Erkennung der Dienstplan-PDFs (Schlüssel von https://console.anthropic.com)
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: E-Mail-Eingang für PDFs (kann auch in der Verwaltung eingetragen werden)
# MAIL_IMAP_HOST=imap.example.de
# MAIL_IMAP_PORT=993
# MAIL_USER=dienstplan@deinname.de
# MAIL_PASSWORD=...
# MAIL_ADDRESS=dienstplan@deinname.de
# MAIL_INTERVAL_MIN=5
